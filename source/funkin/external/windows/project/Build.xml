<?xml version="1.0" encoding="UTF-8"?>
<xml>
  <pragma once="true" />

  <files id="haxe">
    <compilerflag value="-I${this_dir}/include" />
  </files>

  <files id="__main__">
    <compilerflag value="-I${this_dir}/include" />
  </files>

  <files id="external-windows">
    <compilerflag value="-I${this_dir}/include" />
    <file name="${this_dir}/src/windows.cpp" />
  </files>

  <target id="haxe">
    <section if="mingw">
      <lib name="-lkernel32" />
      <lib name="-ldwmapi" />
    </section>

    <section unless="mingw">
      <lib name="kernel32.lib" />
      <lib name="dwmapi.lib" />
    </section>

    <files id="external-windows" />
  </target>
</xml>
